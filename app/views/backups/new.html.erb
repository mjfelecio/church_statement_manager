<div class="w-full max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold mb-6">Restore Backup</h1>

  <div class="alert alert-soft alert-warning border-warning mb-6">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-alert-triangle">
      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
      <path d="M12 9v4" />
      <path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0" />
      <path d="M12 16h.01" />
    </svg>
    <span>
      Restoring a backup will permanently replace all existing data. This action cannot be undone.
    </span>
  </div>

  <%= form_with(url: backup_path, local: true, multipart: true, class: "contents") do |form| %>
    <div class="card bg-base-100 border border-base-300">
      <div class="card-body">
        <div class="form-control">
          <%= form.label :backup_file, "Select Backup File", class: "label" %>
          <%= form.file_field :backup_file,
            accept: ".json",
            required: true,
            class: "file-input file-input-bordered w-full" %>
        </div>

        <div class="card-actions justify-end mt-6">
          <%= form.submit "Upload & Validate",
            class: "btn btn-warning" %>
        </div>
      </div>
    </div>
  <% end %>

  <div class="divider">OR</div>

  <div class="card bg-base-100 border border-base-300">
    <div class="card-body">
      <h2 class="card-title">Download Backup</h2>
      <p class="text-sm text-base-content/70">
        Download a complete backup of all application data as a JSON file.
      </p>
      <div class="card-actions justify-end mt-2">
        <%= link_to "Download Backup",
          download_backup_path,
          data: { turbo: false },
          class: "btn btn-primary" %>
      </div>
    </div>
  </div>
</div>
