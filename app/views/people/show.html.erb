<% content_for :title, @person.name %>

<div class="md:w-2/3 space-y-6 w-full center-page">
  <!-- Person Details -->
  <div class="card bg-base-100 border border-base-300">
    <div class="card-body">
      <h2 class="card-title">Person Details</h2>
      <div class="grid gap-4 md:grid-cols-2">
        <div>
          <div class="label">Name</div>
          <div class="font-medium"><%= @person.name %></div>
        </div>
        <div>
          <div class="label">Position</div>
          <div class="font-medium"><%= @person.position %></div>
        </div>
        <div>
          <div class="label">Statements Prepared</div>
          <div class="text-xl font-medium"><%= @person.prepared_statements.count %></div>
        </div>
        <div>
          <div class="label">Statements Approved</div>
          <div class="text-xl font-medium"><%= @person.approved_statements.count %></div>
        </div>
      </div>
    </div>
  </div>
  <div class="flex justify-end gap-2">
    <%= link_to "Edit", edit_person_path(@person), class: "btn btn-primary" %>
    <%= link_to "Back", people_path, class: "btn btn-outline" %>
    <%= button_to "Delete",
      @person,
      method: :delete,
      class: "btn btn-error",
      data: { turbo_confirm: "Delete #{@person.name}?" } %>
  </div>
</div>
