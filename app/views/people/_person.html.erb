<div id="<%= dom_id person %>" class="card card-compact bg-base-100 border border-base-300 hover:border-base-content/30 hover:shadow-sm transition-all">
  <div class="card-body p-4">
    <%= link_to person_path(person), class: "block group" do %>
      <div class="min-w-0">
        <h3 class="text-lg font-bold group-hover:underline">
          <%= person.name %>
        </h3>

        <div class="mt-0.5 text-sm text-base-content/50">
          <%= person.position %>
        </div>
      </div>

      <div class="divider my-3"></div>
    <% end %>

    <div class="flex justify-end gap-2">
      <%= link_to "Edit", edit_person_path(person), class: "btn btn-sm btn-ghost" %>

      <%= button_to "Delete",
        person,
        method: :delete,
        class: "btn btn-sm btn-ghost text-error",
        data: { turbo_confirm: "Delete #{person.name}?" } %>
    </div>
  </div>
</div>
