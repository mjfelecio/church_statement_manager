<%= form_with(model: person, class: "contents") do |form| %>
  <% if person.errors.any? %>
    <div class="alert alert-error mb-6">
      <div>
        <h2 class="font-semibold">
          <%= pluralize(person.errors.count, "error") %> prohibited this person from being saved:
        </h2>

        <ul class="list-disc ml-6 mt-2">
          <% person.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="space-y-6">
    <!-- Person Details -->
    <div class="card bg-base-100 border border-base-300">
      <div class="card-body">
        <h2 class="card-title">Person Details</h2>

        <div class="form-control">
          <%= form.label :name, class: "label" %>
          <%= form.text_field :name, class: "input input-bordered w-full" %>
        </div>

        <div class="form-control mt-4">
          <%= form.label :position, class: "label" %>
          <%= form.text_field :position,
            class: "input input-bordered w-full",
            placeholder: "e.g. Chapel Treasurer" %>
        </div>
      </div>
    </div>

    <div class="flex justify-end gap-2">
      <%= form.submit class: "btn btn-primary" %>

      <%= link_to "Cancel",
        people_path,
        class: "btn btn-ghost" %>
    </div>
  </div>
<% end %>
