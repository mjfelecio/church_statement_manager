<% content_for :title, "People" %>
<div class="w-full center-page">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">People</h1>
    <%= link_to "New person", new_person_path, class: "btn btn-primary" %>
  </div>
  <div class="divider"></div>
  <div id="people" class="space-y-3">
    <% if @people.any? %>
      <%= render @people %>
    <% else %>
      <p class="text-center text-base-content/50 my-10">No people found.</p>
    <% end %>
  </div>
</div>
