<% content_for :title, "Accounts" %>
<div class="w-full center-page">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Accounts</h1>
    <%= link_to "New account", new_account_path, class: "btn btn-primary" %>
  </div>
  <div class="divider"></div>
  <div class="space-y-6">
    <!-- Income -->
    <div class="card bg-base-100 border border-base-300">
      <div class="card-body">
        <h2 class="card-title">Income</h2>
        <% if @accounts.income.any? %>
          <div class="overflow-x-auto">
            <table class="table">
              <thead>
                <tr>
                  <th>Code</th>
                  <th>Account</th>
                  <th>Group</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% @accounts.income.each do |account| %>
                  <%= render account %>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-center text-base-content/50 my-6">No income accounts yet.</p>
        <% end %>
      </div>
    </div>
    <!-- Expenses -->
    <div class="card bg-base-100 border border-base-300">
      <div class="card-body">
        <h2 class="card-title">Expenses</h2>
        <% if @accounts.expense.any? %>
          <div class="overflow-x-auto">
            <table class="table">
              <thead>
                <tr>
                  <th>Code</th>
                  <th>Account</th>
                  <th>Group</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% @accounts.expense.each do |account| %>
                  <%= render account %>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-center text-base-content/50 my-6">No expense accounts yet.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
