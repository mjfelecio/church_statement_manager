<%= form_with(model: account, class: "contents") do |form| %>
  <% if account.errors.any? %>
    <div class="alert alert-error mb-6">
      <div>
        <h2 class="font-semibold">
          <%= pluralize(account.errors.count, "error") %> prohibited this account from being saved:
        </h2>

        <ul class="list-disc ml-6 mt-2">
          <% account.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="space-y-6">
    <!-- Account Details -->
    <div class="card bg-base-100 border border-base-300">
      <div class="card-body">
        <h2 class="card-title">Account Details</h2>

        <div class="grid gap-4 md:grid-cols-2">
          <div class="form-control">
            <%= form.label :code, class: "label" %>
            <%= form.text_field :code, class: "input input-bordered w-full" %>
          </div>

          <div class="form-control">
            <%= form.label :category, class: "label" %>
            <%= form.select :category,
              category_options,
              {},
              class: "select select-bordered w-full" %>
          </div>
        </div>

        <div class="form-control mt-4">
          <%= form.label :name, class: "label" %>
          <%= form.text_field :name, class: "input input-bordered w-full" %>
        </div>

        <div class="form-control mt-4">
          <%= form.label :group, class: "label" %>
          <%= form.text_field :group,
            class: "input input-bordered w-full",
            placeholder: "Optional, e.g. Remittance" %>
          <p class="text-xs text-base-content/50 mt-1">Groups accounts with the same heading on the printed statement.</p>
        </div>

        <div class="form-control mt-4">
          <%= form.label :description, class: "label" %>
          <%= form.textarea :description,
            rows: 3,
            class: "textarea textarea-bordered w-full" %>
        </div>
      </div>
    </div>

    <div class="flex justify-end gap-2">
      <%= form.submit class: "btn btn-primary" %>

      <%= link_to "Cancel",
        accounts_path,
        class: "btn btn-ghost" %>
    </div>
  </div>
<% end %>
