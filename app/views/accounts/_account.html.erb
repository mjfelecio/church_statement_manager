<div id="<%= dom_id account %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Code:</strong>
    <%= account.code %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= account.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= account.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Category:</strong>
    <%= account.category %>
  </div>
</div>
