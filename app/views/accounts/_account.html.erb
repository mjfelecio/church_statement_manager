<div id="<%= dom_id account %>" class="py-4">
  <div class="flex items-center justify-between gap-4">
    <div class="flex">
      <% if account.group.present? %>
        <h3 class="text-lg text-success font-semibold">
          [<%= account.group %>]
        </h3>
      <% end %>

      <h3 class="text-lg font-semibold">
        <%= account.name %>
      </h3>
    </div>

    <div class="flex gap-2 shrink-0">
      <div class="badge badge-outline">
        <%= account.code %>
      </div>

      <div class="badge <%= badge_variant(account.category) %>">
        <%= account.category.humanize %>
      </div>
    </div>
  </div>
</div>
