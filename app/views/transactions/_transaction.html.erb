<div id="<%= dom_id transaction %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Statement:</strong>
    <%= transaction.statement_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= transaction.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Group name:</strong>
    <%= transaction.group_name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Amount:</strong>
    <%= transaction.amount %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Account:</strong>
    <%= transaction.account_id %>
  </div>
</div>
