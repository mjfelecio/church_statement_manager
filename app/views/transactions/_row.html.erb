<div id="transaction-<%= f.object.id %>" data-transaction-row class="grid grid-cols-12 gap-2 py-1 items-start">

  <div class="col-span-3">
    <%= f.select :account_id,
      account_options(f.object.account_id, category),
      { },
      class: "select select-bordered w-full",
      data: {
        action: "change->transactions#updateAccountCategory",
        transaction_id: f.object.id
      } %>
  </div>

  <div class="col-span-4">
    <%= f.text_field :description,
      placeholder: "Description",
      class: "input input-bordered w-full" %>
  </div>

  <div class="col-span-2">
    <%= f.text_field :group_name,
      placeholder: "Group",
      class: "input input-bordered w-full" %>
  </div>

  <div class="col-span-2">
    <%= f.number_field :amount,
      step: :any,
      placeholder: "0.00",
      class: "input input-bordered w-full",
      data: {
        statement_target: "amount",
        category: category,
        action: "input->statement#recalculateBalance"
      } %>
  </div>

  <%= f.hidden_field :_destroy, value: 0 %>

  <div class="col-span-1">
    <button
      type="button"
      class="btn btn-square btn-ghost text-error"
      data-action="transactions#deleteRow"
      data-transaction-id="<%= f.object.id %>"
    >
      ✕
    </button>
  </div>

</div>
