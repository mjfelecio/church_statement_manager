<div class="drawer lg:drawer-open">
  <input id="sidebar" type="checkbox" class="drawer-toggle" >

  <!--The actual page-->
  <div class="drawer-content flex flex-col">
    <!-- Page content here -->
    <%= yield %>
  </div>

  <div class="drawer-side is-drawer-close:overflow-visible">
    <label for="sidebar" aria-label="Close Sidebar" class="drawer-overlay"></label>

    <div class="flex min-h-full flex-col items-start bg-base-200 is-drawer-close:w-18 is-drawer-open:w-80">
      <!-- Sidebar content here -->
      <ul class="menu bg-base-200 w-full grow">
        <!-- Open Sidebar Button and Logo -->
        <label
          for="sidebar"
          aria-label="Toggle Sidebar"
          class="list-row flex items-center gap-3 rounded-md p-4 hover:bg-base-300 cursor-pointer"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>

          <div class="is-drawer-close:hidden">
            <p class="font-semibold">Parish Ledger</p>
          </div>
        </label>


        <div class="divider"></div>

        <div class="list">
          <!-- Main Sidebar Items -->
          <%= link_to(root_path, class: "list-row hover:bg-base-300 is-drawer-close:tooltip is-drawer-close:tooltip-right", data: { tip: "Dashboard" }) do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-layout-dashboard">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M5 4h4a1 1 0 0 1 1 1v6a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1v-6a1 1 0 0 1 1 -1" />
              <path d="M5 16h4a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1v-2a1 1 0 0 1 1 -1" />
              <path d="M15 12h4a1 1 0 0 1 1 1v6a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1v-6a1 1 0 0 1 1 -1" />
              <path d="M15 4h4a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1v-2a1 1 0 0 1 1 -1" />
            </svg>
            <span class="is-drawer-close:hidden">Dashboard</span>
          <% end %>
          <%= link_to(statements_path, class: "list-row hover:bg-base-300 is-drawer-close:tooltip is-drawer-close:tooltip-right", data: { tip: "Statements" }) do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-file-invoice">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M14 3v4a1 1 0 0 0 1 1h4" />
              <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2" />
              <path d="M9 7l1 0" />
              <path d="M9 13l6 0" />
              <path d="M13 17l2 0" />
            </svg>
            <span class="is-drawer-close:hidden">Statements</span>
          <% end %>

          <div class="divider"></div>

          <!-- Others frfr -->
          <%= link_to(accounts_path, class: "list-row hover:bg-base-300 is-drawer-close:tooltip is-drawer-close:tooltip-right", data: { tip: "Accounts" }) do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-receipt-dollar">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M5 21v-16a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v16l-3 -2l-2 2l-2 -2l-2 2l-2 -2l-3 2" />
              <path d="M14.8 8a2 2 0 0 0 -1.8 -1h-2a2 2 0 1 0 0 4h2a2 2 0 1 1 0 4h-2a2 2 0 0 1 -1.8 -1" />
              <path d="M12 6v10" />
            </svg>
            <span class="is-drawer-close:hidden">Accounts</span>
          <% end %>
          <%= link_to(people_path, class: "list-row hover:bg-base-300 is-drawer-close:tooltip is-drawer-close:tooltip-right", data: { tip: "People" }) do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-users">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M5 7a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
              <path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
              <path d="M16 3.13a4 4 0 0 1 0 7.75" />
              <path d="M21 21v-2a4 4 0 0 0 -3 -3.85" />
            </svg>
            <span class="is-drawer-close:hidden">People</span>
          <% end %>
        </div>

        <div class="divider"></div>

        <div class="list">
          <span class="list-row text-xs font-semibold uppercase tracking-wider text-base-content/50 is-drawer-close:hidden">Backup</span>
          <%= link_to(download_backup_path, class: "list-row hover:bg-base-300 is-drawer-close:tooltip is-drawer-close:tooltip-right", data: { tip: "Download Backup", turbo: false }) do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-download">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2" />
              <path d="M7 11l5 5l5 -5" />
              <path d="M12 4l0 12" />
            </svg>
            <span class="is-drawer-close:hidden">Download Backup</span>
          <% end %>
          <%= link_to(new_backup_path, class: "list-row hover:bg-base-300 is-drawer-close:tooltip is-drawer-close:tooltip-right", data: { tip: "Restore Backup" }) do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-upload">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2" />
              <path d="M7 11l5 -5l5 5" />
              <path d="M12 4l0 12" />
            </svg>
            <span class="is-drawer-close:hidden">Restore Backup</span>
          <% end %>
        </div>
      </ul>
    </div>
  </div>
</div>
