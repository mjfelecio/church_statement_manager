<div id="transaction-<%= f.object.id %>" data-transaction-row class="grid grid-cols-9 gap-2 py-1 items-start">
  <div class="col-span-1 flex items-center min-h-10">
    <span data-account-code class="font-mono text-sm"><%= f.object.account&.code %></span>
  </div>

  <div class="col-span-4">
    <%= f.select :account_id,
      account_options(
        f.object.account_id,
        category,
        disabled_ids: local_assigns.fetch(:disabled_ids, [])
      ),
      { prompt: "Select account" },
      class: "select select-bordered w-full",
      data: {
        transaction_id: f.object.id,
        action: "change->transactions#updateCode change->transactions#syncDisabledOptions"
      } %>
  </div>

  <div class="col-span-3">
    <%= f.number_field :amount,
      step: :any,
      placeholder: "0.00",
      class: "input input-bordered w-full",
      data: {
        statement_target: "amount",
        category: category,
        action: "input->statement#recalculateBalance"
      } %>
  </div>

  <div class="col-span-1 flex items-center justify-end">
    <%= f.hidden_field :_destroy, value: 0 %>
    <button
      type="button"
      class="btn btn-square btn-outline text-error"
      data-action="transactions#deleteRow"
      data-transaction-id="<%= f.object.id %>"
    >
      ✕
    </button>
  </div>
</div>
