<% content_for :title, "Statements" %>

<div class="w-full center-page">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Statements</h1>
    <%= link_to "New statement", new_statement_path, class: "btn btn-primary" %>
  </div>

  <div class="divider"></div>

  <div id="statements" class="space-y-3">
    <%= render @statements %>
  </div>
</div>
