<%= form_with(model: statement, class: "contents", data: { controller: "statement" }) do |form| %>
  <% if statement.errors.any? %>
    <div class="alert alert-error mb-6">
      <div>
        <h2 class="font-semibold">
          <%= pluralize(statement.errors.count, "error") %> prohibited this statement from being saved:
        </h2>

        <ul class="list-disc ml-6 mt-2">
          <% statement.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="space-y-6">

    <!-- Statement Details -->
    <div class="card bg-base-100 border border-base-300">
      <div class="card-body">
        <h2 class="card-title">Statement Details</h2>

        <div class="grid gap-4 md:grid-cols-3">
          <div class="form-control">
            <%= form.label :month, class: "label" %>
            <%= form.select :month,
              month_options(statement.month),
              {},
              class: "select select-bordered w-full",
              data: {
                statement_target: "month",
                action: "change->statement#refreshBeginningBalance"
              }
            %>
          </div>

          <div class="form-control">
            <%= form.label :year, class: "label" %>
            <%= form.number_field :year,
              value: statement.year || Date.today.year,
              class: "input input-bordered w-full",
              data: {
                statement_target: "year",
                action: "change->statement#refreshBeginningBalance"
              }
            %>
          </div>
        </div>
      </div>
    </div>

    <!-- Balances -->
    <div class="card bg-base-100 border border-base-300">
      <div class="card-body">
        <h2 class="card-title">Balances</h2>

        <div class="grid gap-4 md:grid-cols-2">
          <div class="form-control">
            <%= form.label :beginning_balance, class: "label" %>
            <h4 class="text-xl font-medium">₱
              <span data-statement-target="startingBalance">
                <%= statement.beginning_balance %>
              </span>
            </h4>
          </div>

          <div class="form-control">
            <%= form.label :ending_balance, class: "label" %>
            <h4 class="text-xl font-medium">₱
              <span data-statement-target="endingBalance">
                <%= statement.ending_balance %>
              </span>
            </h4>
          </div>
        </div>

        <% unless statement.initial_balance_statement_present? %>
          <div class="divider"></div>
          <%= form.label :initial_balance, class: "label" %>
          <%= form.number_field :initial_balance,
            value: statement.initial_balance,
            class: "input input-bordered w-full",
            data: {
              statement_target: "initialBalance",
              action: "input->statement#recalculateBalance"
            }
            %>
          <p class=" text-amber-800">
            This should only be entered once when creating the first statement.
            After a statement is finalized, its ending balance becomes the
            initial / beginning balance of the next statement automatically.
          </p>
        <% end %>
      </div>
    </div>

    <!-- Transactions -->
    <div class="card bg-base-100 border border-base-300">
      <div class="card-body">
        <h2 class="card-title">Transactions</h2>

        <div data-controller="transactions">

          <!-- ========================= -->
          <!-- Income -->
          <!-- ========================= -->
          <div>
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-semibold">Income</h3>

              <button
                type="button"
                data-action="transactions#addIncomeRow"
                class="btn btn-dash"
              >
                + Add Income
              </button>
            </div>

            <div class="overflow-x-auto">
              <div class="grid grid-cols-10 gap-2 font-semibold text-sm border-b pb-2 mb-2">
                <div class="col-span-3">Account</div>
                <div class="col-span-4">Description (Optional)</div>
                <div class="col-span-2">Amount</div>
                <div class="col-span-1"></div>
              </div>

              <div data-transactions-target="incomeRows">
                <%= form.fields_for :transactions do |transaction_form| %>
                  <% if transaction_form.object.account&.income? || transaction_form.object.new_record? %>
                    <%= render "statements/transaction_row", f: transaction_form, category: :income %>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>

          <div class="divider"></div>

          <!-- ========================= -->
          <!-- Expenses -->
          <!-- ========================= -->
          <div>
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-semibold">Expenses</h3>

              <button
                type="button"
                data-action="transactions#addExpenseRow"
                class="btn btn-dash"
              >
                + Add Expense
              </button>
            </div>

            <div class="overflow-x-auto">
              <div class="grid grid-cols-10 gap-2 font-semibold text-sm border-b pb-2 mb-2">
                <div class="col-span-3">Account</div>
                <div class="col-span-4">Description (Optional)</div>
                <div class="col-span-2">Amount</div>
                <div class="col-span-1"></div>
              </div>

              <div data-transactions-target="expenseRows">
                <%= form.fields_for :transactions do |transaction_form| %>
                  <% if transaction_form.object.account&.expense? %>
                    <%= render "statements/transaction_row", f: transaction_form, category: :expense %>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Templates -->
          <template data-transactions-target="incomeTemplate">
            <%= form.fields_for :transactions, Transaction.new, child_index: "NEW_RECORD" do |f| %>
              <%= render "statements/transaction_row", f: f, category: :income %>
            <% end %>
          </template>

          <template data-transactions-target="expenseTemplate">
            <%= form.fields_for :transactions, Transaction.new, child_index: "NEW_RECORD" do |f| %>
              <%= render "statements/transaction_row", f: f, category: :expense %>
            <% end %>
          </template>

        </div>
      </div>
    </div>

    <!-- Signatories -->
    <div class="card bg-base-100 border border-base-300">
      <div class="card-body">
        <h2 class="card-title">Signatories</h2>

        <div class="grid gap-4 md:grid-cols-2">
          <div class="form-control">
            <%= form.label :prepared_by_id, "Prepared By", class: "label" %>
            <%= form.select :prepared_by_id,
              person_options,
              {},
              class: "select select-bordered w-full" %>
          </div>

          <div class="form-control">
            <%= form.label :approved_by_id, "Approved By", class: "label" %>
            <%= form.select :approved_by_id,
              person_options,
              {},
              class: "select select-bordered w-full" %>
          </div>
        </div>
      </div>
    </div>

    <!-- Finalization -->
    <% if statement.persisted? %>
      <div class="card card-border border-error bg-error/5">
        <div class="card-body">
          <h2 class="card-title text-error">
            Finalize Statement
          </h2>

          <p class="text-sm text-base-content/80">
            Finalizing this statement marks it as officially reviewed and approved.
            Once finalized, the statement and its transactions can no longer be
            modified. Any corrections or missing transactions must be recorded in a
            future month's statement.
          </p>

          <div class="alert alert-soft alert-warning border-warning mt-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-alert-triangle">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M12 9v4" />
              <path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0" />
              <path d="M12 16h.01" />
            </svg>
            <span>
              Ensure all balances, transactions, and signatories have been reviewed
              before finalizing.
            </span>
          </div>

          <div class="card-actions justify-end mt-4">
            <%= link_to "Finalize Statement",
              finalize_statement_path(statement),
              data: {
                turbo_method: :patch,
                turbo_confirm: "Are you sure you want to finalize this statement?\n\nOnce finalized, the statement and its transactions can no longer be edited."
              },
              class: "btn btn-error" %>
          </div>
        </div>
      </div>
    <% end %>

    <div class="flex justify-end gap-2">
      <%= form.submit class: "btn btn-primary" %>

      <%= link_to "Cancel",
        statements_path,
        class: "btn btn-ghost" %>
    </div>

  </div>
<% end %>
