<%= form_with(model: statement, class: "contents", data: { controller: "statement" }) do |form| %>
  <% if statement.errors.any? %>
    <div class="alert alert-error mb-6">
      <div>
        <h2 class="font-semibold">
          <%= pluralize(statement.errors.count, "error") %> prohibited this statement from being saved:
        </h2>

        <ul class="list-disc ml-6 mt-2">
          <% statement.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="space-y-6">

    <!-- Statement Details -->
    <div class="card bg-base-100 border border-base-300">
      <div class="card-body">
        <h2 class="card-title">Statement Details</h2>

        <div class="grid gap-4 md:grid-cols-3">
          <div class="form-control">
            <%= form.label :chapel_id, "Chapel", class: "label" %>
            <%= form.select :chapel_id,
              chapel_options,
              {},
              class: "select select-bordered w-full" %>
          </div>

          <div class="form-control">
            <%= form.label :month, class: "label" %>
            <%= form.select :month,
              month_options,
              { selected: statement.month || Date.today.month},
              class: "select select-bordered w-full" %>
          </div>

          <div class="form-control">
            <%= form.label :year, class: "label" %>
            <%= form.number_field :year,
              value: statement.year || Date.today.year,
              class: "input input-bordered w-full" %>
          </div>
        </div>
      </div>
    </div>

    <!-- Balances -->
    <div class="card bg-base-100 border border-base-300">
      <div class="card-body">
        <h2 class="card-title">Balances</h2>

        <div class="grid gap-4 md:grid-cols-2">
          <div class="form-control">
            <%= form.label :beginning_balance, class: "label" %>
            <h4 class="text-xl font-medium">₱ <span data-statement-target="startingBalance"></span></h4>
          </div>

          <div class="form-control">
            <%= form.label :ending_balance, class: "label" %>
            <h4 class="text-xl font-medium">₱ <span data-statement-target="endingBalance"></span></h4>
          </div>
        </div>
      </div>
    </div>

    <!-- Transactions -->
    <div class="card bg-base-100 border border-base-300">
      <div class="card-body">
        <h2 class="card-title">Transactions</h2>

        <div class="overflow-x-auto">
          <div class="grid grid-cols-12 gap-2 font-semibold text-sm border-b pb-2 mb-2">
            <div class="col-span-3">Account</div>
            <div class="col-span-4">Description</div>
            <div class="col-span-2">Group</div>
            <div class="col-span-2">Amount</div>
            <div class="col-span-1"></div>
          </div>

          <div data-controller="transactions">
            <!-- Visible rows -->
            <div data-transactions-target="rows">
              <%= form.fields_for :transactions do |transaction_form| %>
                <%= render "transactions/row", f: transaction_form %>
              <% end %>
            </div>

            <!-- Row template -->
            <template data-transactions-target="template">
              <%= form.fields_for :transactions, Transaction.new, child_index: "NEW_RECORD" do |f| %>
                <%= render "transactions/row", f: f %>
              <% end %>
            </template>

            <button
              type="button"
              data-action="transactions#addRow"
              class="btn btn-dash block px-12 mt-4 mx-auto"
            >
              + Add Transaction
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Signatories -->
    <div class="card bg-base-100 border border-base-300">
      <div class="card-body">
        <h2 class="card-title">Signatories</h2>

        <div class="grid gap-4 md:grid-cols-2">
          <div class="form-control">
            <%= form.label :prepared_by_id, "Prepared By", class: "label" %>
            <%= form.select :prepared_by_id,
              person_options,
              {},
              class: "select select-bordered w-full" %>
          </div>

          <div class="form-control">
            <%= form.label :approved_by_id, "Approved By", class: "label" %>
            <%= form.select :approved_by_id,
              person_options,
              {},
              class: "select select-bordered w-full" %>
          </div>
        </div>
      </div>
    </div>

    <!-- Finalization -->
    <div class="card bg-base-100 border border-base-300">
      <div class="card-body">
        <h2 class="card-title">Finalization</h2>

        <div class="form-control">
          <%= form.label :finalized_at, class: "label" %>
          <%= form.datetime_field :finalized_at,
            class: "input input-bordered w-full" %>
        </div>
      </div>
    </div>

    <div class="flex justify-end gap-2">
      <%= form.submit class: "btn btn-primary" %>

      <%= link_to "Cancel",
        statements_path,
        class: "btn btn-ghost" %>
    </div>

  </div>
<% end %>
