<div id="<%= dom_id statement %>" class="card card-compact bg-base-100 border border-base-300 hover:border-base-content/30 hover:shadow-sm transition-all">
  <div class="card-body p-4">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
          <h3 class="text-lg font-bold">
            <%= statement.month.humanize %> <%= statement.year %>
          </h3>
          <span class="badge <%= statement.finalized_at.present? ? "badge-success" : "badge-ghost" %> badge-sm">
            <%= statement.finalized_at.present? ? "Finalized" : "Draft" %>
          </span>
        </div>

        <div class="mt-0.5 text-sm text-base-content/50">
          <span>Prepared by <%= statement.prepared_by.name %></span>
          <span class="mx-1.5">·</span>
          <span>Approved by <%= statement.approved_by.name %></span>
        </div>
      </div>

      <div class="text-right shrink-0">
        <div class="text-xl font-semibold tracking-tight">
          ₱<%= number_with_precision(statement.ending_balance, precision: 2, delimiter: ",") %>
        </div>
        <div class="text-[10px] uppercase tracking-wider text-base-content/40">Ending Balance</div>
      </div>
    </div>

    <div class="divider my-3"></div>

    <div class="flex justify-end gap-2">
      <%= link_to "Edit", edit_statement_path(statement), class: "btn btn-sm btn-ghost" %>
      <%= button_to "Delete", statement, method: :delete, class: "btn btn-sm btn-ghost text-error", data: { turbo_confirm: "Are you sure?" } %>
    </div>
  </div>
</div>
