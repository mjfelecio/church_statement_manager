<div id="<%= dom_id statement %>" class="py-4">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="text-lg font-semibold">
        <%= Statement::CHAPEL_NAME %>
      </h3>

      <p class="text-sm text-base-content/70">
        <%= statement.month.humanize %> <%= statement.year %>
      </p>

      <div class="mt-2 text-sm text-base-content/70">
        Prepared by <%= statement.prepared_by.name %>
      </div>

      <div class="text-sm text-base-content/70">
        Approved by <%= statement.approved_by.name %>
      </div>
    </div>

    <div class="flex flex-col items-end gap-2 shrink-0">
      <div class="badge badge-outline">
        <%= statement.finalized_at.present? ? "Finalized" : "Draft" %>
      </div>

      <div class="text-right">
        <div class="text-xs uppercase text-base-content/60">
          Ending Balance
        </div>

        <div class="font-semibold">
          ₱<%= number_with_precision(statement.ending_balance, precision: 2, delimiter: ",") %>
        </div>
      </div>
    </div>
  </div>
</div>
