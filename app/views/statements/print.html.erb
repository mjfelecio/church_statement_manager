<% provide(:title, @statement.display_name) %>

<div class="center-page not-print:min-w-2xl print:w-full">
  <!-- Header -->
  <div class="text-center font-bold mb-8">
    <h2>SANTA MONICA PARISH</h2>
    <h3><%= Statement::CHAPEL_NAME.upcase %></h3>
    <p><%= Statement::CHAPEL_ADDRESS.upcase %></p>

    <h2 class="mt-4">
      STATEMENT OF RECEIPTS AND EXPENDITURES
    </h2>

    <p>
      FOR THE MONTH OF
      <%= @statement.month.upcase %>
      <%= @statement.year %>
    </p>
  </div>

  <!-- Beginning Balance -->
  <div class="mt-8">
    <strong>CASH BEGINNING BALANCE:</strong>

    <div class="pl-4 w-full flex justify-between items-center">
      <p>Cash On Hand</p>
      <strong class="text-right underline-offset-4 decoration-double underline">
        <%= number_to_currency(@statement.beginning_balance, unit: "₱") %>
      </strong>
    </div>
  </div>

  <br>

  <!-- Receipts -->
  <h4 class="font-bold">ADD CASH RECEIPTS</h4>

  <%= render "transaction_section",
    transactions: @statement.income_transactions %>

  <table class="w-full mt-4">
    <tr>
      <td>
        <strong>TOTAL CASH RECEIPTS</strong>
      </td>

      <td class="text-right font-bold underline-offset-4 underline">
        <%= number_to_currency(@statement.total_income, unit: "₱") %>
      </td>
    </tr>

    <tr>
      <td>
        <strong>TOTAL AVAILABLE FUNDS</strong>
      </td>

      <td class="text-right font-bold underline-offset-4 underline">
        <%= number_to_currency(@statement.available_funds, unit: "₱") %>
      </td>
    </tr>
  </table>

  <br>

  <!-- Expenses -->
  <h4 class="font-bold">LESS CASH DISBURSEMENT:</h4>

  <%= render "transaction_section",
    transactions: @statement.expense_transactions %>

  <table class="w-full mt-4">
    <tr>
      <td>
        <strong>TOTAL CASH DISBURSEMENT</strong>
      </td>

      <td class="text-right font-bold underline-offset-4 underline">
        <%= number_to_currency(@statement.total_expenses, unit: "₱") %>
      </td>
    </tr>

    <tr class="align-top">
      <td>
        <strong>TOTAL CASH BALANCE END as of <%= last_day_of_month_of_statement(@statement) %></strong>
      </td>

      <td class="text-right underline-offset-4 font-bold decoration-double underline"><%= number_to_currency(@statement.ending_balance, unit: "₱") %></td>
    </tr>
  </table>

  <!-- Details -->
  <div class="mt-8">
    <strong>DETAILS:</strong>

    <div class="pl-4">
      <span>Cash On Hand: </span>
      <strong class="underline underline-offset-4 decoration-double"><%= number_to_currency(@statement.ending_balance, unit: "₱") %></strong>
    </div>
  </div>

  <!-- Signatures -->
  <div class="mt-16 grid grid-rows-2 grid-cols-2">
    <div class="flex text-center row-start-1 row-end-1">
      PREPARED BY:

      <div class="text-center leading-tight">
        <div class="mt-6 underline inline-block">
          <%= @statement.prepared_by.name.upcase %>
        </div>

        <div> <%= @statement.prepared_by.position.upcase %> </div>
      </div>
    </div>

    <div class="flex text-center col-start-2 col-end-2 row-start-2 row-end-2 justify-self-end">
      APPROVED BY:

      <div class="text-center leading-tight">
        <div class="mt-6 underline inline-block">
          <%= @statement.approved_by.name.upcase %>
        </div>

        <div> <%= @statement.approved_by.position.upcase %> </div>
      </div>
    </div>
  </div>

</div>
